CREATE TABLE expenseEntity (
    id TEXT NOT NULL PRIMARY KEY,
    tripId TEXT NOT NULL,
    title TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currencyCode TEXT NOT NULL,
    category TEXT NOT NULL,
    spentAtEpochMillis INTEGER NOT NULL,
    notes TEXT
);

CREATE INDEX expenseEntity_tripId ON expenseEntity(tripId);

selectExpensesByTrip:
SELECT * FROM expenseEntity WHERE tripId = ? ORDER BY spentAtEpochMillis DESC;

upsertExpense:
INSERT OR REPLACE INTO expenseEntity
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteExpense:
DELETE FROM expenseEntity WHERE id = ?;
